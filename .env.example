# ============================================
# SMART CITY RDC 2035 — Environment variables
# ============================================
# Copy to .env.local (dev). NEVER commit real values. Only NEXT_PUBLIC_* reach the browser.

# ---------- Browser-safe (public) ----------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Alternative moderne (sb_publishable_...) : utilisee si NEXT_PUBLIC_SUPABASE_ANON_KEY est vide. Jamais de cle service_role / sb_secret_ ici.
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# ATTENTION : les NEXT_PUBLIC_* sont figees AU BUILD. Les definir avant `npm run build` (Render : onglet Environment, puis redeployer).
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Show demo e-mail shortcuts on /login (never a password). Keep "false" in production.
NEXT_PUBLIC_DEMO_MODE=false
# Optional: contact shown when a source is not configured
NEXT_PUBLIC_SENTRY_DSN=

# ---------- Server only (Next.js server / CI / local scripts) ----------
# Do NOT prefix with NEXT_PUBLIC_. Edge Functions receive SUPABASE_URL / SUPABASE_ANON_KEY /
# SUPABASE_SERVICE_ROLE_KEY automatically from Supabase; the rest are set with `supabase secrets set`.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# ---------- Edge Function secrets (supabase secrets set KEY=value) ----------
# CORS: comma-separated exact origins. Empty = CORS closed (browser calls blocked).
ALLOWED_ORIGINS=http://localhost:3000
# AI = Google Gemini (REST generateContent, key sent in the x-goog-api-key header). If GEMINI_API_KEY or AI_MODEL
# is empty, /ai-service/classify-report answers "IA non configurée" and /ai-service/status lists what is missing.
# Server-side secrets ONLY (supabase secrets set ...). NEVER commit a real key, never prefix with NEXT_PUBLIC_.
# Create the key in Google AI Studio (https://aistudio.google.com/apikey).
GEMINI_API_KEY=
# Exact model id, e.g. the value shown by the official model list (https://ai.google.dev/gemini-api/docs/models) or by
# GET https://generativelanguage.googleapis.com/v1beta/models. No default on purpose: model names change over time.
AI_MODEL=
# Optional: Gemini call timeout in ms (bounded 1000..60000, default 20000).
# AI_TIMEOUT_MS=20000
# IoT: simulation endpoint is OFF unless true. Simulated rows are flagged and excluded from real KPIs.
IOT_SIMULATION_ENABLED=false
# Demo accounts: OFF unless true; needs ADMIN_SEED_PASSWORD (>= 16 chars, never committed).
ALLOW_DEMO_PROVISIONING=false
ADMIN_SEED_PASSWORD=
