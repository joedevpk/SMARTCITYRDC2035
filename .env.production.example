# Production environment
# Copy to .env.production and fill with real values before deploying

# Supabase — public credentials come from .env (same for all environments)
# Only server-side keys are overridden here for production
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Application
NEXT_PUBLIC_APP_URL=https://smartcity-rdc.cd
NODE_ENV=production

# Security — set a strong password (min 20 chars)
ADMIN_SEED_PASSWORD=

# CORS — production domain only
ALLOWED_ORIGINS=https://smartcity-rdc.cd,https://www.smartcity-rdc.cd
